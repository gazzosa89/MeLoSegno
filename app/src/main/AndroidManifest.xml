<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeLoSegno">
        <activity
            android:name="com.example.melosegno.MainActivity"
            android:exported="true"
            android:label="@string/note_label"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeLoSegno"
            android:windowSoftInputMode="adjustResize" />

        <!-- Widget della nota fissata: toccarlo apre l'app su quella nota. -->
        <receiver
            android:name=".widget.PinnedNoteWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pinned_note_widget_info" />
        </receiver>

        <!-- Alias del launcher: una variante per combinazione di
         etichetta e colore; una sola e' abilitata alla volta,
         scelta da Impostazioni (quella predefinita resta abilitata
         nel manifest per non lasciare l'app senza icona dopo un
         aggiornamento, prima del primo avvio). -->
        <activity-alias
            android:name="com.example.melosegno.Launcher_Note_default"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_default"
            android:roundIcon="@mipmap/ic_launcher_default"
            android:label="@string/note_label"
            android:targetActivity="com.example.melosegno.MainActivity"
            android:theme="@style/Theme.MeLoSegno">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
